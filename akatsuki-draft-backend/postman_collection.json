    {
      "name": "User - Post Management",
      "item": [
        {
          "name": "Create Post / Save Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Journey with Node.js and AI\",\n  \"description\": \"A quick reflection on modern web development with Gemini.\",\n  \"content\": \"node.js is very fast. i built this project for nodevember 4.0 using express and gemini api. it supports drafting and admin review.\",\n  \"category\": \"Technology\",\n  \"status\": \"draft\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          }
        },
        {
          "name": "Create and Submit for Approval",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Architecting Scalable Microservices\",\n  \"description\": \"Best practices for event-driven backend architectures.\",\n  \"content\": \"Microservices require decoupled architectures, robust message queues like RabbitMQ or Kafka, and idempotent event handlers.\",\n  \"category\": \"Software Engineering\",\n  \"status\": \"pending\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          }
        },
        {
          "name": "View All Approved Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "category", "value": "", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "View Approved Post by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{postId}}"]
            }
          }
        },
        {
          "name": "View My Posts & Drafts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/my-posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "my-posts"]
            }
          }
        },
        {
          "name": "Update My Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Journey with Node.js and AI (Updated)\",\n  \"status\": \"pending\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{postId}}"]
            }
          }
        },
        {
          "name": "Delete My Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{postId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "AI Integration",
      "item": [
        {
          "name": "Improve Content Using AI (Creates New Draft)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instruction\": \"Make this post sound professional, fix any grammatical issues, add proper markdown headers, and make it engaging for developers.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/improve/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "improve", "{{postId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Post Approval",
      "item": [
        {
          "name": "View Pending Posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/posts/pending",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "posts", "pending"]
            }
          }
        },
        {
          "name": "Approve Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"feedback\": \"Great quality post! Approved for publication.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/posts/approve/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "posts", "approve", "{{postId}}"]
            }
          }
        },
        {
          "name": "Reject Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"feedback\": \"Please expand more on practical use cases before resubmitting.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/posts/reject/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "posts", "reject", "{{postId}}"]
            }
          }
        }
      ]
    }
  ]
}
